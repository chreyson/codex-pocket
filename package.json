{
  "name": "codex-pocket",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A minimal mobile remote for local Codex conversations.",
  "scripts": {
    "vendor:sync": "node scripts/sync-markdown-vendor.mjs",
    "start": "node src/server.mjs",
    "shared": "node scripts/shared-codex.mjs",
    "codex:shared": "node scripts/shared-codex.mjs --open-app",
    "test": "node --test",
    "test:desktop": "python -m unittest discover -s test -p \"test_*.py\"",
    "test:ui": "node scripts/check-ui.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "playwright": "1.58.2"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "marked": "18.0.11",
    "qrcode-generator": "2.0.4",
    "smol-toml": "1.8.0",
    "ws": "8.21.3"
  }
}
