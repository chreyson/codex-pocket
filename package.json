    "test:ui": "node scripts/check-ui.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "marked": "18.0.11"
  }
}
